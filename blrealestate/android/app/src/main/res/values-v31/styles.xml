<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern Splash Screen API for Android 12+ (v31+) -->
    <!-- This ensures a smooth, native launch experience like a "Normal App" -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_v31</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_green</item>
        <item name="android:navigationBarColor">@color/splash_green</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode splash — same green so it's consistent regardless of system theme -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_green</item>
        <item name="android:navigationBarColor">@color/splash_green</item>
    </style>

    <!-- Normal theme applied once Flutter UI is ready -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

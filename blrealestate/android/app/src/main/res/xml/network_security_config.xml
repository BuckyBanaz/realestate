<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic globally — backend serves some image URLs over HTTP -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Backend server uses a self-signed certificate.
         Trust all certificates for this specific host so release builds
         can connect without needing the SSL bypass in Dart code.
         Remove this domain entry once the server has a valid CA-signed cert. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">108.181.185.27</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>

  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9053562174\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/ChannelPartner/send-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ChannelPartner",
                "send-otp"
              ]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9053562174\",\n  \"otp\": \"1234\",\n  \"fcm_token\": \"dummy_token_for_postman\"\n}"
